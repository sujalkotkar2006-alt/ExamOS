# Render/Railway backend. Set these in the hosting service, not in Git.
NODE_ENV=production
HOST=0.0.0.0
EXAMOS_BEHIND_PROXY=1
PUBLIC_APP_URL=https://your-project.vercel.app
PUBLIC_BACKEND_URL=https://your-service.onrender.com
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/examos?sslmode=verify-full
JWT_SECRET=replace-with-a-new-random-secret-at-least-32-characters
# The hosting platform provides PORT. Never set EXAMOS_LOCAL_DB=1 in the cloud.
# The Docker image supplies EXAMOS_MEDIA_PYTHON.

# Vercel frontend: ONLY this public URL is needed; no database/JWT credentials.
VITE_BACKEND_ORIGIN=https://your-service.onrender.com
